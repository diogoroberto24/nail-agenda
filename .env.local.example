# Copie este arquivo para .env.local e preencha. NUNCA commite o .env.local.
# Este arquivo (.env.local.example) é versionado: mantenha-o SEM valores reais.

# Painel do Supabase → Project Settings → API (ou "API Keys")
NEXT_PUBLIC_SUPABASE_URL=https://SEU-PROJETO.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_...

# Usadas SOMENTE pelo script scripts/seed.mjs (rodado na sua máquina). Nunca no navegador,
# nunca com prefixo NEXT_PUBLIC_, nunca na Vercel.
SUPABASE_SECRET_KEY=sb_secret_...

# Contas de teste criadas pelo seed (troque por e-mails pessoais depois)
SEED_SALON_NAME=Salão de Unhas
SEED_PRO1_NAME=Profissional 1
SEED_PRO1_EMAIL=
SEED_PRO1_PASSWORD=
SEED_PRO2_NAME=Profissional 2
SEED_PRO2_EMAIL=
SEED_PRO2_PASSWORD=
